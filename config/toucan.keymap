#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define EXT  4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <120>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        ts: thumb_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        lmc: layer_mouseclick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &none &kp Q      &kp W      &kp E       &kp R       &kp T   &kp Y &kp U       &kp I       &kp O      &kp P         &none
                &none &hm LGUI A &hm LALT S &hm LSHFT D &hm LCTRL F &kp G   &kp H &hm RCTRL J &hm RSHFT K &hm LALT L &hm RGUI SEMI &none
                &none &kp Z      &kp X      &kp C       &kp V       &kp B   &kp N &kp M       &kp COMMA   &kp DOT    &kp FSLH      &none
                                &ts LSHFT TAB  &lt 2 ESCAPE   &kp SPACE      &kp BSPC     &lt 1 ENTER &ts RSHFT DEL
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none &trans       &trans         &trans       &trans       &trans         &trans   &trans    &trans    &trans    &trans &none
                &none &trans       &trans         &trans       &trans       &trans         &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans &none
                &none &trans       &studio_unlock &trans       &trans       &trans         &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans &none
                                &trans &mo EXT &trans   &trans &trans &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none &kp N1    &kp N2          &kp N3    &kp N4      &kp N5      &kp N6    &kp N7   &kp N8   &kp N9   &kp N0   &none
                &none &kp DLLR  &kp CARET       &kp HASH  &kp LS(SQT) &kp MINUS   &kp EQUAL &kp RPAR &kp RBKT &kp RBRC &kp PLUS &none
                &none &kp TILDE &kp KP_MULTIPLY &kp GRAVE &kp SQT     &kp UNDER   &kp PRCNT &kp LPAR &kp LBKT &kp LBRC &kp BSLH &none
                                &trans &trans &trans   &trans &mo ADJ &kp PIPE
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &none &none &none       &none       &none       &none       &none       &none &none &none &none &none
                &none &none &none       &none       &none       &none       &none       &none &none &none &none &none
                &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR &none &none &none &none &none
                                &trans &trans &trans   &trans &trans &trans
            >;
        };

        ext {
            display-name = "EXT";
            bindings = <
                &none &kp F1  &kp F2  &kp F3      &kp F4     &kp F5    &kp C_PP     &kp C_PREV   &kp C_NEXT      &kp C_VOL_DN   &kp C_VOL_UP &none
                &none &kp F6  &kp F7  &kp F8      &kp F9     &kp F10   &kp C_BRI_DN &kp C_BRI_UP &kp PRINTSCREEN &kp C_MUTE     &bootloader  &none
                &none &kp F11 &kp F12 &bootloader &sys_reset &trans    &trans &trans &trans &trans &sys_reset &none
                                &trans &trans &trans   &trans &trans &trans
            >;
        };
    };
};
