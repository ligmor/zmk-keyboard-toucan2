#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define MOU  4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        lmc: layer_mouseclick {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&mkp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none  &none  &hm LGUI A  &hm LALT S  &hm LCTRL D  &hm LSHFT F  &kp G  &kp H  &hm RSHFT J  &hm RCTRL K  &hm LALT L  &hm RGUI SEMI  &none  &none  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none  &lt 3 ENTER  &lt 1 TAB  &kp SPACE  &kp BSPC  &lt 2 ESCAPE  &lmc 4 RCLK
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&none  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &none  &none  &bt BT_CLR  &studio_unlock  &trans  &trans  &trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &trans  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&none  &kp EXCL  &kp AT  &kp LBRC  &kp RBRC  &kp PIPE  &kp AMPS  &kp KP_MULTIPLY  &kp EQUAL  &kp BSLH  &kp LS(FSLH)  &none  &none  &kp HASH  &kp DLLR  &kp LPAR  &kp RPAR  &kp GRAVE  &kp MINUS  &kp PLUS  &kp UNDER  &kp LS(SQT)  &kp SQT  &none  &none  &kp PRCNT  &kp CARET  &kp LBKT  &kp RBKT  &kp TILDE  &kp LS(COMMA)  &kp LS(DOT)  &kp SEMI  &kp LS(SEMI)  &kp FSLH  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp C_PP  &kp C_PREV  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &none  &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp C_BRI_DN  &kp C_BRI_UP  &kp PRINTSCREEN  &kp C_MUTE  &trans  &none  &none  &kp F11  &kp F12  &bootloader  &sys_reset  &trans  &bt BT_NXT  &bt BT_PRV  &bt BT_CLR  &bt BT_CLR_ALL  &trans  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        ext {
            display-name = "ADJ";
            bindings = <
&none  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp C_PP  &kp C_PREV  &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &none  &none  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp C_BRI_DN  &kp C_BRI_UP  &kp PRINTSCREEN  &kp C_MUTE  &bootloader  &none  &none  &kp F11  &kp F12  &bootloader  &sys_reset  &trans  &bt BT_NXT  &bt BT_PRV  &bt BT_CLR  &bt BT_CLR_ALL  &sys_reset  &none  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
